EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(dim_duid[FuelSourceDescriptor], "avg", [Average generation MW], "share", [Generation share]), dim_calendar[date] >= dt"2026-07-28", dim_calendar[date] <= dt"2026-08-11", dim_duid[FuelSourceDescriptor] = "Wind"), "series", [FuelSourceDescriptor], "avg", [avg], "share", [share]) ORDER BY [avg] DESC, [series]
